# Copy this file to .env in the project's working directory on the EC2 box
# and fill in a real generated token. .env is git-ignored -- never commit
# the real one. Both rma-mcp.service and rma-api.service read this same file.
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_BEARER_TOKEN=replace-with-a-generated-token

# Optional: only set this if you want the REST API to use a DIFFERENT token
# than the MCP server. Left unset (or commented out), it falls back to
# MCP_BEARER_TOKEN above, so one token protects both services.
# API_BEARER_TOKEN=replace-with-a-different-token

# Email (send_card_offer_email tool). SMTP_HOST and MAIL_FROM are required for
# sending; without them the tool returns a "not configured" error.
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
# While testing, send every email to this address instead of the customer's.
# Remove (or comment out) to go live.
MAIL_REDIRECT_TO=""
