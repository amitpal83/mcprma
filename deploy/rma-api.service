[Unit]
Description=RMA REST API (Digital RM Twin demo)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/rma/rma
EnvironmentFile=/home/ec2-user/rma/rma/.env
ExecStart=/home/ec2-user/rma/rma/venv/bin/python -m uvicorn api.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
