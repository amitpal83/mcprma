          },
          {
            "name": "amount_min",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Minimum amount (foreign-currency or INR)",
              "title": "Amount Min"
            },
            "description": "Minimum amount (foreign-currency or INR)"
          },
          {
            "name": "amount_max",
            "in": "query",
