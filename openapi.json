              "title": "From Date"
            },
            "description": "Start of the date range (inclusive), e.g. 2026-09-01"
          },
          {
            "name": "to_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "End of the date range (inclusive), e.g. 2026-09-30",
